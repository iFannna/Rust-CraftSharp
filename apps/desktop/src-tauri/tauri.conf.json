{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "CraftSharp",
  "version": "0.1.0",
  "identifier": "com.craftsharp.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "CraftSharp",
        "width": 1500,
        "height": 900,
        "minWidth": 720,
        "minHeight": 480,
        "x": 80,
        "y": 80,
        "center": false,
        "resizable": true
      },
      {
        "label": "hud",
        "title": "CraftSharp HUD",
        "url": "hud.html",
        "width": 819,
        "height": 266,
        "x": 550,
        "y": 814,
        "transparent": true,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "focus": false,
        "shadow": false
      },
      {
        "label": "inventory",
        "title": "物品栏",
        "url": "inventory.html",
        "width": 1056,
        "height": 996,
        "x": 420,
        "y": 140,
        "transparent": true,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "visible": false,
        "shadow": false
      },
      {
        "label": "overlay",
        "title": "灰色蒙版",
        "url": "overlay.html",
        "width": 800,
        "height": 600,
        "x": 0,
        "y": 0,
        "transparent": true,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "focus": false,
        "visible": false,
        "shadow": false
      },
      {
        "label": "settings",
        "title": "CraftSharp 设置",
        "url": "settings.html",
        "width": 980,
        "height": 640,
        "center": true,
        "transparent": true,
        "decorations": false,
        "skipTaskbar": true,
        "resizable": false,
        "visible": false,
        "shadow": true
      },
      {
        "label": "crosshair",
        "title": "准星",
        "url": "crosshair.html",
        "width": 800,
        "height": 600,
        "x": 0,
        "y": 0,
        "transparent": true,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "focus": false,
        "visible": false,
        "shadow": false
      },
      {
        "label": "tooltip",
        "title": "提示框",
        "url": "tooltip.html",
        "width": 200,
        "height": 80,
        "transparent": true,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "focus": false,
        "visible": false,
        "shadow": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/icon.ico"
    ]
  }
}