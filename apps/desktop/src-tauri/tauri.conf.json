{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "CraftSharp",
  "mainBinaryName": "CraftSharp",
  "version": "26.11.26",
  "identifier": "com.craftsharp.desktop",
  "build": {
    "beforeDevCommand": "node scripts/dev-server.mjs",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "settings",
        "title": "CraftSharp 设置",
        "url": "pages/settings.html",
        "width": 1080,
        "height": 720,
        "minWidth": 720,
        "minHeight": 480,
        "center": true,
        "decorations": false,
        "resizable": true,
        "visible": false,
        "shadow": true,
        "create": false
      },
      {
        "label": "hud",
        "title": "CraftSharp HUD",
        "url": "pages/hud.html",
        "width": 200,
        "height": 100,
        "transparent": true,
        "decorations": false,
        "alwaysOnTop": false,
        "skipTaskbar": true,
        "resizable": false,
        "focus": false,
        "visible": false,
        "shadow": false,
        "create": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "publisher": "iFannna",
    "copyright": "© 2025 iFannna",
    "shortDescription": "Minecraft 风格的 Windows 桌面管理应用",
    "longDescription": "CraftSharp 把 Minecraft 的 HUD、快捷栏、物品栏与壁纸引擎带到 Windows 桌面。",
    "homepage": "https://github.com/iFannna/Rust-CraftSharp",
    "category": "Utility",
    "icon": [
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      },
      "nsis": {
        "installerHooks": "nsis/hooks.nsh",
        "installMode": "currentUser",
        "languages": ["SimpChinese", "English"],
        "displayLanguageSelector": true,
        "installerIcon": "icons/icon.ico",
        "uninstallerIcon": "icons/icon.ico",
        "startMenuFolder": "CraftSharp"
      },
      "wix": {
        "language": ["zh-CN", "en-US"]
      }
    }
  }
}
