{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "CraftSharp",
  "version": "0.1.0",
  "identifier": "com.craftsharp.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "CraftSharp",
        "url": "pages/index.html",
        "width": 1500,
        "height": 900,
        "minWidth": 720,
        "minHeight": 480,
        "x": 80,
        "y": 80,
        "center": false,
        "resizable": true,
        "visible": false,
        "skipTaskbar": true
      },
      {
        "label": "hud",
        "title": "CraftSharp HUD",
        "url": "pages/hud.html",
        "width": 200,
        "height": 100,
        "transparent": true,
        "decorations": false,
        "alwaysOnTop": false,
        "skipTaskbar": true,
        "resizable": false,
        "focus": false,
        "visible": false,
        "shadow": false
      },
      {
        "label": "settings",
        "title": "CraftSharp 设置",
        "url": "pages/settings.html",
        "width": 1080,
        "height": 720,
        "minWidth": 720,
        "minHeight": 480,
        "center": true,
        "decorations": false,
        "resizable": true,
        "visible": false,
        "shadow": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/icon.ico"
    ]
  }
}